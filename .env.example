# Contact form (api/contact.ts) — Resend email delivery.
# Copy this file to .env.local for local `vercel dev` testing, and set
# the same three values in the Vercel dashboard (Project -> Settings ->
# Environment Variables) for production. Never commit the real values.

# Resend dashboard -> API Keys
RESEND_API_KEY=

# The inbox you want contact-form messages delivered to
CONTACT_TO_EMAIL=

# Optional. Defaults to Resend's shared onboarding@resend.dev, which
# only delivers to your own Resend account's email — fine for testing,
# not for real visitors. Verify a domain in Resend -> Domains, then set
# this to an address on it, e.g. contact@yourdomain.com
CONTACT_FROM_EMAIL=
